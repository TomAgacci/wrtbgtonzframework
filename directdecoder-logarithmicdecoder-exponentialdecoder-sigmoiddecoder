}
uint16_t decode_sigmoid(double duration_us,
                        double base_us,
                        double slope_us)
{
    double y = (duration_us - base_us) / slope_us;
    double k = 12.0;

    double x = (log((1.0 / y) - 1.0) / -k) + 0.5;

    if (x < 0.0) x = 0.0;
    if (x > 1.0) x = 1.0;

    return (uint16_t)round(x * 65535.0);
}
