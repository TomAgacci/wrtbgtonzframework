#!/bin/sh /etc/rc.common

START=95
STOP=05

SERVICE_NAME="morsebandd"
BIN_PATH="/usr/sbin/morsebandd"
CFG_PATH="/etc/morsebandd.conf"
TUN_NAME="morse0"

start() {
    echo "Starting $SERVICE_NAME..."
    if [ ! -f "$BIN_PATH" ]; then
        echo "Error: $BIN_PATH not found"
        return 1
    fi

    # Create tun interface if needed
    ip tuntap add dev $TUN_NAME mode tun 2>/dev/null
    ip link set $TUN_NAME up

    # Launch daemon
    $BIN_PATH $CFG_PATH $TUN_NAME &
    echo "$SERVICE_NAME started."
}

stop() {
    echo "Stopping $SERVICE_NAME..."
    killall morsebandd 2>/dev/null
    ip link set $TUN_NAME down 2>/dev/null
    ip tuntap del dev $TUN_NAME 2>/dev/null
    echo "$SERVICE_NAME stopped."
}

restart() {
    stop
    sleep 1
    start
}
